# HippoRAG Environment Variables Example
# Copy this file to .env and fill in your values

# ============== Docker Deployment ==============
# For Docker deployment, the following settings are pre-configured:
# - DGraph: dgraph:9080 (container service name)
# - PostgreSQL: db:5432 (container service name)
# You only need to set OPENAI_API_KEY and optionally model names.

# ============== API Configuration ==============
# Host and port for the API server
API_HOST=0.0.0.0
API_PORT=8000

# ============== HippoRAG Configuration ==============
# Directory to save HippoRAG data
HIPPORAG_SAVE_DIR=./outputs

# ============== OpenAI Configuration ==============
# OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key

# Unified base URL for OpenAI-compatible services
# If set, this will be used for both LLM and Embedding unless overridden
# OPENAI_BASE_URL=https://api.openai.com/v1

# For Dashscope (Alibaba Cloud):
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HIPPORAG_LLM_MODEL=qwen-turbo
# HIPPORAG_EMBEDDING_MODEL=text-embedding-v3

# For Silicon Cloud:
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# HIPPORAG_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# HIPPORAG_EMBEDDING_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============== LLM Configuration ==============
# LLM model name (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
HIPPORAG_LLM_MODEL=gpt-4o-mini

# LLM base URL (optional, overrides OPENAI_BASE_URL for LLM)
# HIPPORAG_LLM_BASE_URL=https://api.openai.com/v1

# ============== Embedding Configuration ==============
# Embedding model name (e.g., text-embedding-3-small, text-embedding-3-large)
HIPPORAG_EMBEDDING_MODEL=text-embedding-3-small

# Embedding base URL (optional, overrides OPENAI_BASE_URL for Embedding)
# HIPPORAG_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ============== DGraph Configuration ==============
# DGraph GRPC connection string
DGRAPH_GRPC=localhost:9080

# ============== PostgreSQL (pgvector) Configuration ==============
# Database URL for PostgreSQL with pgvector
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hipporag

# Individual PostgreSQL settings
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=hipporag
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=

# ============== Logging ==============
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
